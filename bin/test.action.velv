actions {
  log(value: expression) {
    print(value)
  }

  repeat(count: expression, body: block) {
    auto index = 0
    while (index < count) {
      body
      index = index + 1
    }
  }

  unless(condition: expression, body: block) {
    if (!condition) {
      body
    }
  }

  test_assert(name: string, condition: expression) {
    if (!condition) {
      print("❌ FAIL: " + name)
    } else {
      print("✅ PASS: " + name)
    }
  }

  transaction(db_name: string, logic: block) {
    print("🔹 OPENING TRANSACTION on " + db_name)
    try {
      logic
      print("✅ COMMIT TRANSACTION")
    } catch (e) {
      print("❌ ROLLBACK TRANSACTION due to error: " + e)
    }
  }

  fetch_api(method: string, url: string, retries: number, secure: boolean, callback: block) {
    print("🌐 Making " + method + " request to " + url)
    print("🔄 Retries allowed: " + retries)
    if (secure) {
      print("🔒 Using secure connection")
    } else {
      print("⚠️ WARNING: Using insecure connection")
    }
    
    auto attempts = 0
    while (attempts < retries) {
      print("➡️ Attempt " + (attempts + 1) + "...")
      callback
      attempts = attempts + 1
    }
  }
}

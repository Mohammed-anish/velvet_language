import "url.velv"
import "dns.velv"

async fn testNetworking() {
  print("Testing URL parsing:")
  auto u = URL.parse("https://google.com/search?q=velvet")
  print("Scheme: " + u.scheme)
  print("Host: " + u.host)
  print("Path: " + u.path)

  print("\nTesting DNS lookup:")
  auto ips = await DNS.lookup(u.host)
  print("IPs for google.com: ")
  print(ips)
}

await testNetworking()

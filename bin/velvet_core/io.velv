class File {
    String path = ""
    
    fn init(path) {
        this.path = path
    }

    outer fn create()
    outer fn delete()
    outer fn exists()
    outer fn readAsString()
    outer fn writeAsString(content)
    outer fn appendAsString(content)
}

class Http {
    static outer async fn get(url, headers)
    static outer async fn post(url, body, headers)
    static outer async fn put(url, body, headers)
    static outer async fn delete(url, headers)
}

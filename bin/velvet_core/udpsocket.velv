/// A User Datagram Protocol (UDP) socket.
/// 
/// UDPSocket allows you to send and receive datagrams connectionlessly over a network.
class UDPSocket {
  static outer async fn bind(host, port)
  outer async fn send(data, host, port)
  outer async fn sendBytes(buffer, host, port)
  outer async fn receive()
  outer async fn receiveBytes()
  outer async fn close()
}

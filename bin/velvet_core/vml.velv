class VML {
    static outer fn parse(source)
    static outer fn parseFile(path)
    static outer fn toHTML(source)
}

class VmlDocument {
    outer fn toHTML()
    outer fn nodes()
}

class VmlElement {
    outer fn querySelector(tag)
    outer fn querySelectorAll(tag)
    outer fn findId(id)
    outer fn findGroup(group)
    outer fn getAttribute(name)
    outer fn setAttr(name, value)
    outer fn removeAttr(name)
    outer fn append(node)
    outer fn remove(node)
    outer fn setText(text)
    outer fn on(event, callback)
    outer fn toHTML()
    outer fn tagName()
    outer fn attributes()
    outer fn children()
    outer fn parent()
    outer fn next()
    outer fn prev()
}

class VmlText {
    outer fn text()
    outer fn setText(text)
    outer fn toHTML()
    outer fn parent()
    outer fn next()
    outer fn prev()
}
